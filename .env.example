# ===========================================================
# SHOPPERZ MART - Environment Configuration
# ===========================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ===========================================================

# === Database ===
# Use 'db' for Docker, 'localhost' for local dev
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=password
DATABASE_NAME=ecommerce

# === Server Ports ===
# API_PORT=NestJS API
# WEB_PORT=React Web Storefront
# ADMIN_PORT=React Admin Panel
# DEV_DB_PORT=Host port for DB in hybrid dev mode (avoids conflict with local PostgreSQL)
API_PORT=3000
WEB_PORT=3001
ADMIN_PORT=3002
DEV_DB_PORT=5433

# === Admin Panel Authentication ===
ADMIN_EMAIL=admin@shopperzmart.com
ADMIN_PASSWORD=change_this_password
ADMIN_JWT_SECRET=generate_a_random_secret_here

# === CORS (for production deployment) ===
# CORS_ORIGINS=https://yourdomain.com,https://admin.yourdomain.com
